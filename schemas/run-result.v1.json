{
  "$id": "run-result.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "origin": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "local",
            "ci"
          ]
        },
        "workflowRunUrl": {
          "type": "string",
          "format": "uri"
        },
        "runNumber": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "git": {
      "type": "object",
      "properties": {
        "sha": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "required": [
        "sha",
        "branch",
        "dirty"
      ],
      "additionalProperties": false
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped",
              "not_run"
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "blocking",
          "status",
          "durationMs"
        ],
        "additionalProperties": false
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "flaky",
              "skipped"
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "retries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]+-\\d{3}$"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          },
          "detail": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "playwright-report",
                  "trace",
                  "screenshot",
                  "video"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "path"
            ],
            "additionalProperties": false
          },
          "triage": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "producto",
                  "test",
                  "entorno",
                  "inestable",
                  "desconocido"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "category",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "file",
          "stage",
          "status",
          "durationMs",
          "retries",
          "requirements",
          "tags"
        ],
        "additionalProperties": false
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-\\d{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "capability",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "semgrep",
              "npm-audit",
              "licenses",
              "zap"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "production",
              "development"
            ]
          },
          "accepted": {
            "type": "string"
          }
        },
        "required": [
          "source",
          "severity",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "agentActions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "agent": {
            "type": "string",
            "enum": [
              "revisor-specs",
              "analista",
              "disenador",
              "automatizador",
              "api",
              "auditor-experiencia",
              "auditor-seguridad",
              "triaje",
              "sanador",
              "detector-flaky",
              "reportero"
            ]
          },
          "change": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "executedBy": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "date",
          "agent",
          "change",
          "action",
          "artifacts",
          "summary",
          "executedBy"
        ],
        "additionalProperties": false
      }
    },
    "injectedDefect": {
      "type": "string",
      "enum": [
        "cupon",
        "selector",
        "caida"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "status",
    "startedAt",
    "finishedAt",
    "origin",
    "git",
    "stages",
    "tests",
    "requirements",
    "metrics",
    "findings",
    "agentActions"
  ],
  "additionalProperties": false
}
